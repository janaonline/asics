# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Model and reasoning effort (low | medium | high | xhigh | max)
ASICS_MODEL=claude-sonnet-5-5   # the ceiling: Sonnet 5.5 at most (sonnet-5-5, sonnet-5, haiku-5-5)
ASICS_EFFORT=medium
# Retry on a suitable model if a safety classifier declines a request
ASICS_ENABLE_FALLBACKS=true

# Inputs and outputs
# The question bank is set per vertical in agent_setup/verticals/<name>.md; this is only
# used for a vertical without a settings file.
ASICS_QUESTION_BANK=data/question_banks/Parastatal_ASICS_Question_Bank.xlsx
ASICS_CITY_REGISTER=data/cities/ASICS_Cities_and_Parastatals.xlsx
ASICS_OUTPUTS_DIR=outputs
ASICS_AGENT_SETUP_DIR=agent_setup   # agents, prompts, skills and the team's memory
ASICS_VERTICAL=parastatal           # the default vertical (agent_setup/verticals/<name>.md)
ASICS_MEMORY_MAX_CHARS=20000        # memory text given to the model per call

# Research limits
ASICS_MAX_CONCURRENCY=4          # parastatals / questions worked on at the same time
ASICS_CHECK_WORKERS=3            # links checked at the same time, per parastatal
# ASICS_FIND_SOURCES_MAX_USES=5  # web searches and web fetches (each) per source-finding call; unset = the agent file's max_uses (5). More = better coverage, higher cost: each search adds ~50k input tokens
ASICS_MAX_EVIDENCE_CHARS=60000   # source text given to the model per answer
# ASICS_STEP2_BATCH=true           # Step 2 via Anthropic's Message Batches: half price, answers take minutes to an hour longer. false = answer live
# ASICS_STEP2_BATCH_LIVE_UP_TO=5  # a Step 2 round with this many calls or fewer is sent live (the slow last answers)
# ASICS_ASSESS_EVIDENCE_CHARS=15000 # Step 1: page text the source assessor reads (15000 matched 60000 in tests)
ASICS_HTTP_TIMEOUT=30
ASICS_LLM_CALL_TIMEOUT=900       # seconds; a research call taking longer is stopped
ASICS_API_READ_TIMEOUT=180       # seconds without data from Claude before retrying

# Optional: LangSmith tracing (https://smith.langchain.com)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=asics-agent
